// -----------------------------------------------------------------------------
// Konfiguration der Meeting-KI-Firmware  –  Board: ESP32-S3 Zero (Waveshare)
//
// Diese Datei nach `config.h` kopieren und ausfüllen:
//     cp src/config.h.example src/config.h
//
// `config.h` ist in .gitignore und wird NICHT eingecheckt (enthält WLAN-Passwort).
//
// Die Pin-Vorgaben passen zum ESP32-S3 Zero (alle auf der vorderen Stiftleiste,
// GPIO1–GPIO13). Die WS2812-Onboard-LED sitzt fest auf GPIO21.
// -----------------------------------------------------------------------------
#pragma once

// ---- WLAN -------------------------------------------------------------------
// Hinweis: Der ESP32-S3 funkt nur im 2,4-GHz-WLAN (kein 5 GHz).
#define WIFI_SSID       "DEIN_WLAN_NAME"
#define WIFI_PASSWORD   "DEIN_WLAN_PASSWORT"

// ---- Server (der Rechner, auf dem server.py läuft) --------------------------
#define SERVER_HOST     "192.168.1.100"   // lokale IP des Servers (siehe README)
#define SERVER_PORT     8888

// ---- I2S-Pins zum INMP441 ---------------------------------------------------
#define I2S_SCK_PIN     4   // INMP441 SCK  (Bit-Clock / BCLK)
#define I2S_WS_PIN      5   // INMP441 WS   (Word-Select / LRCLK)
#define I2S_SD_PIN      6   // INMP441 SD   (Serial Data Out)

// L/R-Kanalwahl des INMP441, hier vom ESP32 über GPIO3 gesteuert.
// LOW  = linker Kanal  (passt zu I2S_CHANNEL_FMT_ONLY_LEFT in main.cpp)
// HIGH = rechter Kanal
#define MIC_LR_PIN      3
#define MIC_LR_LEVEL    LOW

// ---- Audio ------------------------------------------------------------------
#define SAMPLE_RATE     16000  // 16 kHz reicht für Sprache (gut für Whisper)

// Software-Verstärkung: Das INMP441 ist recht leise. Der Rohwert (32 Bit) wird
// um MIC_SHIFT nach rechts geschoben, um auf 16 Bit zu kommen. Kleinerer Wert =
// lauter. Bei Übersteuerung erhöhen, bei zu leisem Ton verringern (Bereich ~8..14).
#define MIC_SHIFT       11

// ---- Knöpfe (Steuerung am ESP32) --------------------------------------------
// Variante A (USE_TOGGLE_BUTTON 1): EIN Knopf als Start/Stop-Umschalter.
//   Ideal, um den vorhandenen BOOT-Knopf zu nutzen – keine zusätzlichen Taster!
//   BOOT-Pin je Board:  ESP32-S3 Zero = GPIO0 , ESP32-C3 Super Mini = GPIO9
//   (BOOT nur im Betrieb drücken, NICHT beim Einschalten/Reset.)
// Variante B (USE_TOGGLE_BUTTON 0): zwei getrennte Taster (Start + Stop).
#define USE_TOGGLE_BUTTON 1
#define TOGGLE_BUTTON_PIN 0   // BOOT auf ESP32-S3 Zero. C3 Super Mini: 9

// Nur für Variante B (zwei Taster gegen GND, interner Pullup aktiv):
#define START_BUTTON_PIN 1   // Aufnahme starten
#define STOP_BUTTON_PIN  2   // Aufnahme beenden

// Entprellzeit der Taster in Millisekunden
#define BUTTON_DEBOUNCE_MS 50

// ---- Energiesparen (Deep Sleep) ---------------------------------------------
// Nach SLEEP_TIMEOUT_MS ohne laufende Aufnahme geht der ESP in Deep Sleep und
// wacht per Knopfdruck wieder auf (danach ~2-3 s Neustart + WLAN-Reconnect).
// 0 = aus.
#define ENABLE_DEEP_SLEEP 1
#define SLEEP_TIMEOUT_MS  60000   // 60 Sekunden

// Weck-Pin – MUSS aus Deep Sleep wecken können!
//   ESP32-S3 Zero: GPIO0 (BOOT) funktioniert.
//   ESP32-C3:      NUR GPIO0..GPIO5 können wecken – GPIO9 (BOOT) geht NICHT!
//                  Nimm am C3 z. B. GPIO1 als Knopf (dann TOGGLE_BUTTON_PIN
//                  ebenfalls auf 1 setzen). Der Knopf braucht einen Pullup nach
//                  3V3 (BOOT-Knopf hat ihn onboard; eigener Taster ggf. 10k).
#define WAKE_BUTTON_PIN   0

// ---- Status-LED -------------------------------------------------------------
// ESP32-S3 Zero: adressierbare WS2812-RGB-LED fest auf GPIO21.
// STATUS_LED_IS_WS2812 = 1 -> WS2812 (Farbe), = 0 -> einfache Ein/Aus-LED.
// STATUS_LED_ACTIVE_LOW = 1 -> LED leuchtet bei LOW (viele einfache Onboard-LEDs).
// STATUS_LED_PIN = -1 schaltet die Status-LED ganz aus.
#define STATUS_LED_PIN        21
#define STATUS_LED_IS_WS2812  1
#define STATUS_LED_ACTIVE_LOW 0

// Helligkeit der WS2812 (0..255). Die Onboard-LED ist sehr hell – niedrig halten.
#define LED_BRIGHTNESS        40

// LED-Bedeutung (bei WS2812 als Farbe):
//   rot blinkend      = kein WLAN
//   orange blinkend   = WLAN ok, aber kein Server
//   grün (gedimmt)    = verbunden, wartet auf Start-Knopf
//   rot (dauerhaft)   = Aufnahme läuft

// -----------------------------------------------------------------------------
// ALTERNATIVE: ESP32-C3 Super Mini
// -----------------------------------------------------------------------------
// Funktioniert ebenfalls (WLAN + 1x I2S). Nutze das Board-Env esp32-c3-supermini
// in platformio.ini und ersetze oben die Pin-/LED-Werte durch diese:
//
//   #define I2S_SCK_PIN     4
//   #define I2S_WS_PIN      5
//   #define I2S_SD_PIN      6
//   #define MIC_LR_PIN      3
//   // BOOT (GPIO9) kann NICHT aus Deep Sleep wecken. Bei ENABLE_DEEP_SLEEP 1
//   // daher einen Knopf an GPIO0..GPIO5 verwenden (hier GPIO1) für Toggle UND Wecken:
//   #define USE_TOGGLE_BUTTON 1
//   #define TOGGLE_BUTTON_PIN 1
//   #define WAKE_BUTTON_PIN   1
//   // (ohne Deep Sleep ginge auch der BOOT-Knopf: TOGGLE_BUTTON_PIN 9)
//   // (oder zwei eigene Taster: USE_TOGGLE_BUTTON 0 und START/STOP z. B. 10 / 7)
//   // Onboard-LED ist eine einfache (active-low) LED auf GPIO8, kein WS2812:
//   #define STATUS_LED_PIN        8
//   #define STATUS_LED_IS_WS2812  0
//   #define STATUS_LED_ACTIVE_LOW 1
//
// Die LED zeigt dann nur an/aus statt Farben (an = Aufnahme läuft / Verbindung
// aktiv, blinkt bei fehlender Verbindung). Strapping-Pins 2/8/9 nicht für zwei
// getrennte Taster verwenden (GPIO9 ist der BOOT-Knopf).
