# Diese Datei nach `.env` kopieren und ausfüllen:  cp .env.example .env
# .env ist in .gitignore und wird NICHT eingecheckt.

# --- Zusammenfassung ---------------------------------------------------------
# Zusammenfassung an-/ausschalten.
ENABLE_SUMMARY=true

# Backend für die Zusammenfassung:
#   claude       -> Anthropic-API (braucht ANTHROPIC_API_KEY)
#   ollama       -> starkes lokales LLM via Ollama, strukturiert, kein Claude (empfohlen für lokal)
#   huggingface  -> kleines lokales Modell, schnell aber unstrukturiert
#   none         -> keine Zusammenfassung
SUMMARY_BACKEND=claude

# -- Backend "claude" --
# API-Schlüssel von https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# -- Backend "ollama" (starkes lokales LLM, ohne Claude) --
# Voraussetzung: Ollama installiert (https://ollama.com/download) und Modell
# geladen (z. B. "ollama pull qwen2.5:7b-instruct").
OLLAMA_MODEL=qwen2.5:7b-instruct
# Stärker (mehr RAM/VRAM, langsamer): qwen2.5:14b-instruct, qwen2.5:32b-instruct, llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192

# -- Backend "huggingface" (kleines lokales Modell) --
# Alternativen z. B.: Einmalumdiewelt/T5-Base_GNAD , ml6team/mt5-small-german-finetune-mlsum
HF_SUMMARY_MODEL=T-Systems-onsite/mt5-small-sum-de-en-v2

# --- Transkription (faster-whisper) -----------------------------------------
# Modellgröße: tiny | base | small | medium | large-v3
# Größer = genauer, aber langsamer und mehr RAM/VRAM.
WHISPER_MODEL=small

# cpu oder cuda (bei NVIDIA-GPU). Bei cpu ggf. int8 als Compute-Typ.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Sprache des Meetings (z. B. de, en). Leer lassen für Auto-Erkennung.
WHISPER_LANGUAGE=de

# --- Sprecher-Trennung / Diarization (optional) -----------------------------
# "Wer spricht wann?" – teilt das Transkript in SPRECHER_1, SPRECHER_2 ...
# Standardmäßig aus. Erfordert:
#   1) pip install -r requirements-diarization.txt
#   2) HUGGINGFACE_TOKEN (unten) von https://huggingface.co/settings/tokens
#   3) Nutzungsbedingungen von "pyannote/speaker-diarization-3.1" auf
#      huggingface.co akzeptieren.
# Hinweis: Mit einem einzelnen, entfernten MEMS-Mikrofon ist die Genauigkeit
# begrenzt.
ENABLE_DIARIZATION=false
HUGGINGFACE_TOKEN=

# --- Netzwerk ----------------------------------------------------------------
# Port, auf dem der Server die ESP32-Verbindung entgegennimmt
# (muss mit SERVER_PORT in der Firmware übereinstimmen).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8888

# --- Audio (muss zur Firmware passen) ---------------------------------------
SAMPLE_RATE=16000
